POSTGRES_PASSWORD=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080
COOKIE_SECURE=false
NODE_ENV=development
TRUST_PROXY=1
APP_ORIGINS=
# Generate privately on the server; missing disables initial super-admin setup.
BOOTSTRAP_SETUP_TOKEN=
RELEASE_TAG=v0.1.0-rc.1
RESEND_API_KEY=
MAIL_FROM=
# Optional Google Drive backups. Supply privately, never commit populated values.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
BACKUP_TOKEN_KEY=
BACKUP_ENVIRONMENT=dev
BACKUP_ORIGIN=http://localhost:8080
BACKUP_PRIVATE_DIR=./backup-private
BACKUP_CONFIG_SOURCE=./backup-config
MINIO_ROOT_USER=trello-media
MINIO_ROOT_PASSWORD=replace-with-a-different-long-random-value
MINIO_IMAGE=minio/minio:latest
